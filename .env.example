# Public HTTPS hostname for the API. Caddy obtains the certificate.
# Use a real domain, or a free wildcard-DNS name such as:
#   api.203.0.113.10.sslip.io
DOMAIN=api.example.com

# Absolute public URL returned in the tunnel response. Must match DOMAIN.
PUBLIC_BASE_URL=https://api.example.com

# Browser origins allowed to call this service. Keep the live site.
ALLOWED_ORIGINS=https://maxrtools.netlify.app

BIND=0.0.0.0
PORT=8080
TRUST_PROXY=1

# Render uses Cloudflare WARP as a free egress path. Keep this at 0 for a
# home/self-hosted deployment so it uses your own residential IP.
# The Docker/Render image defaults to 1; copying this .env.example sets 0.
USE_WARP=0

# Resource/abuse limits.
MAX_CONCURRENT=2
RATE_LIMIT=8
RATE_WINDOW=60
DOWNLOAD_TIMEOUT=600
JOB_TTL=300
MAX_FILESIZE=100M
MAX_DURATION=1800
MAX_HEIGHT=1080

# Optional residential/ISP proxy for a self-hosted VPS (USE_WARP=0).
# The server tries the VPS direct first, then retries through this proxy only
# if the direct attempt fails. Format: http://user:password@host:port
YTDLP_PROXY=
